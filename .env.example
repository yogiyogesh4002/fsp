# Production URL used for canonical links, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Endpoint that receives enquiry form submissions as JSON POST (CRM webhook, form service, serverless function).
NEXT_PUBLIC_FSP_FORM_ENDPOINT=

# Gemini API configuration for Jarvis AI Chatbot
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# OpenRouter (Jarvis primary provider)
#
# One key covers every model — OpenRouter is a single gateway and the model is
# chosen per request. Do NOT create a key per model: free-model rate limits are
# tied to the ACCOUNT (by all-time credits purchased), not to the key, so extra
# keys share the same daily ceiling rather than adding to it.
#
# Check your real ceiling any time:
#   curl -H "Authorization: Bearer $OPENROUTER_API_KEY" \
#        https://openrouter.ai/api/v1/key
# and read `free_model_daily_requests`.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional. Comma-separated fallback chain, best first. Leave unset to use the
# built-in default chain in lib/openrouter.ts. Append !json to force JSON mode
# on for an id. Re-check ids against https://openrouter.ai/api/v1/models —
# free models are added and retired often.
# OPENROUTER_MODELS=google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free,openrouter/free

# Optional. Provider order. Default: openrouter,gemini
# LLM_PROVIDERS=openrouter,gemini
